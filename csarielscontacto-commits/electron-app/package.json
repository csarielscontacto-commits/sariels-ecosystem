{
  "name": "csariels-browser",
  "version": "1.0.0",
  "description": "Csariel's Browser - Hecho en Puebla",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "Csariel's Ecosystem",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@privy-io/react-auth": "^1.60.0"
  },
  "build": {
    "appId": "com.csariels.browser",
    "productName": "Csariel's Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ]
  }
}