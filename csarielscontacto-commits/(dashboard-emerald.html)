    <script>
        // ================================================================
        // SUPABASE CONFIG
        // ================================================================
        const SUPABASE_URL = 'https://nvyyxgkladjauolvpzfp.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im52eXl4Z2tsYWRqYXVvbHZwemZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDA2MTU2ODEsImV4cCI6MjA1NjE5MTY4MX0.c1Zk6QpI7m7tQnY4k8w9Tg5dDw2pXgFh1y3JkLmNpQo';

        let supabaseClient = null;

        function initSupabase() {
            if (typeof supabase === 'undefined') {
                console.warn('⚠️ Supabase no está cargado.');
                return null;
            }
            if (!supabaseClient) {
                supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
                console.log('🔗 Supabase conectado (Mi Internet)');
            }
            return supabaseClient;
        }

        // ================================================================
        // CARGAR PLANES DESDE LOCALSTORAGE
        // ================================================================
        function cargarPlanes() {
            try {
                const guardado = localStorage.getItem('emerald_planes_config');
                if (guardado) {
                    const planes = JSON.parse(guardado);
                    if (planes && planes.length > 0) {
                        return planes;
                    }
                }
            } catch (e) {
                console.warn('Error cargando configuración:', e);
            }
            // Planes por defecto
            return [
                { mb: 500, precio: 49, badge: '💎 Popular', detalle: '~2h de video' },
                { mb: 1024, precio: 89, badge: '🔥 Más vendido', detalle: '~4h de video' },
                { mb: 2048, precio: 149, badge: '🚀 Pro', detalle: '~8h de video' },
                { mb: 5120, precio: 299, badge: '👑 Premium', detalle: '~20h de video' }
            ];
        }

        // ================================================================
        // CARGAR DATOS DE PAGO DESDE LOCALSTORAGE
        // ================================================================
        function cargarDatosPago() {
            const banco = localStorage.getItem('emerald_pago_banco') || 'BBVA México';
            const cuenta = localStorage.getItem('emerald_pago_cuenta') || '1234 5678 9012 3456';
            const titular = localStorage.getItem('emerald_pago_titular') || 'Csariel\'s Ecosystem';
            const clabe = localStorage.getItem('emerald_pago_clabe') || '012 3456 7890 1234 5678 90';
            const email = localStorage.getItem('emerald_pago_email') || 'soporte@csariels.com';

            document.getElementById('pagoBanco').textContent = banco;
            document.getElementById('pagoCuenta').textContent = cuenta;
            document.getElementById('pagoTitular').textContent = titular;
            document.getElementById('pagoClabe').textContent = clabe;
            document.getElementById('pagoEmail').textContent = email;
        }

        // ================================================================
        // RENDERIZAR PLANES
        // ================================================================
        function renderizarPlanes() {
            const grid = document.getElementById('planesGrid');
            const planes = cargarPlanes();

            grid.innerHTML = planes.map(plan => `
                <div class="plan-card" onclick="mostrarPago(${plan.mb}, ${plan.precio}, '${plan.badge || 'Plan'}')">
                    <div class="plan-badge">${plan.badge || '📦 Plan'}</div>
                    <div class="plan-mb">${plan.mb} MB</div>
                    <div class="plan-precio">$${plan.precio} MXN</div>
                    <div class="plan-detalle">${plan.detalle || `~${Math.round(plan.mb / 250)}h de video`}</div>
                    <button class="btn-comprar-plan" onclick="event.stopPropagation(); mostrarPago(${plan.mb}, ${plan.precio}, '${plan.badge || 'Plan'}')">
                        <i class="fas fa-shopping-cart"></i> Comprar
                    </button>
                </div>
            `).join('');
        }

        // ================================================================
        // MOSTRAR PAGO
        // ================================================================
        let planSeleccionado = null;

        function mostrarPago(mb, precio, badge) {
            planSeleccionado = { mb, precio, badge };

            document.getElementById('planSeleccionado').textContent = `${mb} MB - $${precio} MXN`;
            document.getElementById('montoPago').textContent = `$${precio} MXN`;

            // Cargar datos de pago desde localStorage
            cargarDatosPago();

            const section = document.getElementById('paymentSection');
            section.classList.add('visible');
            section.scrollIntoView({ behavior: 'smooth', block: 'center' });

            mostrarToast(`📦 Plan ${mb} MB seleccionado. Revisa los datos de pago.`);
        }

        function cerrarPago() {
            document.getElementById('paymentSection').classList.remove('visible');
            planSeleccionado = null;
        }

        function confirmarPago() {
            if (!planSeleccionado) return;
            
            // Guardar en localStorage para el admin
            const historial = JSON.parse(localStorage.getItem('emerald_pagos_historial') || '[]');
            historial.push({
                fecha: new Date().toISOString(),
                plan: planSeleccionado,
                usuario: localStorage.getItem('csariels_user_name') || 'Usuario'
            });
            localStorage.setItem('emerald_pagos_historial', JSON.stringify(historial));

            mostrarToast(`✅ ¡Pago de $${planSeleccionado.precio} MXN registrado! En breve recibirás tus datos.`);
            cerrarPago();
            actualizarConsumo();
        }

        // ================================================================
        // COPIAR TEXTO
        // ================================================================
        function copiarTexto(id) {
            const el = document.getElementById(id);
            const texto = el.textContent || el.value;
            navigator.clipboard?.writeText(texto);
            mostrarToast('📋 Copiado al portapapeles');
        }

        // ================================================================
        // SIMULAR CONSUMO
        // ================================================================
        function actualizarConsumo() {
            const total = 1024;
            const consumido = Math.floor(Math.random() * 800) + 100;
            const porcentaje = (consumido / total) * 100;
            const restante = total - consumido;

            document.getElementById('consumoFill').style.width = Math.min(porcentaje, 100) + '%';
            document.getElementById('consumoFill').className = 'fill' + (porcentaje > 80 ? ' danger' : porcentaje > 60 ? ' warning' : '');
            document.getElementById('consumoTexto').textContent = `${consumido} MB / ${total} MB`;

            const dias = Math.floor(Math.random() * 20) + 5;
            const pctDias = ((30 - dias) / 30) * 100;
            document.getElementById('renovacionFill').style.width = pctDias + '%';
            document.getElementById('renovacionTexto').textContent = `${dias} días`;
        }

        // ================================================================
        // TOAST
        // ================================================================
        let toastTimeout = null;

        function mostrarToast(mensaje) {
            const toast = document.getElementById('toast');
            toast.textContent = mensaje;
            toast.className = 'toast active';
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('active'), 3000);
        }

        // ================================================================
        // INICIALIZAR
        // ================================================================
        document.addEventListener('DOMContentLoaded', () => {
            console.log('🌿 Mi Internet - Csariel\'s');
            console.log('📦 Planes cargados desde localStorage');

            initSupabase();
            renderizarPlanes();
            cargarDatosPago();
            actualizarConsumo();

            // Actualizar consumo cada 30 segundos
            setInterval(actualizarConsumo, 30000);
        });

        // ================================================================
        // FUNCIONES GLOBALES
        // ================================================================
        window.mostrarPago = mostrarPago;
        window.cerrarPago = cerrarPago;
        window.confirmarPago = confirmarPago;
        window.copiarTexto = copiarTexto;
        window.mostrarToast = mostrarToast;
        window.actualizarConsumo = actualizarConsumo;
        window.cargarDatosPago = cargarDatosPago;
    </script>

</body>
</html>