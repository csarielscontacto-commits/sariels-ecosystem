    <style>
        /* ===== TODOS TUS ESTILOS EXISTENTES (MANTENIDOS) ===== */
        :root {
            --space-deep: #05080f;
            --space-mid: #0a1428;
            --verde-bosque: #0F2D1A;
            --verde-bosque-light: #1a4a2a;
            --gold-base: #F4C430;
            --gold-light: #FFE066;
            --gold-shine: #FFD700;
            --gold-glow: #FF6B00;
            --gold-metal: #D4AF37;
            --gold-dark: #B8860B;
            --gold-shimmer: linear-gradient(135deg, #F4C430 0%, #FFD700 25%, #FF6B00 50%, #FFD700 75%, #F4C430 100%);
            --gold-neon: 0 0 20px rgba(244, 196, 48, 0.3), 0 0 60px rgba(255, 107, 0, 0.15);
            --gold-metal-glow: 0 0 30px rgba(244, 196, 48, 0.2), inset 0 0 30px rgba(255, 215, 0, 0.05);
            --gold-cosmic: #D4AF37;
            --gold-dim: rgba(244, 196, 48, 0.15);
            --text-primary: #e8f0f8;
            --text-secondary: #8ba3c7;
            --text-muted: #4a6a8a;
            --border: rgba(244, 196, 48, 0.12);
            --border-glow: rgba(255, 215, 0, 0.35);
            --radius: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --success: #00b894;
            --danger: #ff3366;
            --warning: #F4C430;
            --quantum: #00e5ff;
            --card-bg: #123722;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--space-deep);
            color: var(--text-primary);
            font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--space-deep); }
        ::-webkit-scrollbar-thumb { background: linear-gradient(var(--gold-base), var(--verde-bosque)); border-radius: 3px; }

        .btn-gold {
            background: var(--gold-shimmer);
            background-size: 300% 300%;
            border-color: transparent;
            color: #0a0c10;
            -webkit-text-fill-color: #0a0c10;
            animation: metal-shimmer-bg 4s ease-in-out infinite;
            box-shadow: var(--gold-neon);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            padding: 8px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.65rem;
        }
        .btn-gold::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.15), transparent);
            transform: rotate(45deg);
            animation: metal-sweep 3s ease-in-out infinite;
        }
        @keyframes metal-sweep {
            0% { transform: translateX(-100%) rotate(45deg); }
            100% { transform: translateX(100%) rotate(45deg); }
        }
        .btn-gold:hover {
            transform: scale(1.03);
            box-shadow: 0 0 40px rgba(244, 196, 48, 0.5), 0 0 80px rgba(255, 107, 0, 0.25);
        }
        @keyframes metal-shimmer-bg {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .post-card {
            background: var(--card-bg);
            border: 2px solid transparent;
            border-image: linear-gradient(135deg, #F4C430, #FFD700, #FF6B00, #FFD700, #F4C430) 1;
            border-image-slice: 1;
            animation: metal-border-shift 4s ease-in-out infinite;
            box-shadow: var(--gold-neon);
            border-radius: var(--radius);
            padding: 16px;
            display: flex;
            gap: 14px;
            transition: all 0.3s;
        }
        .post-card:hover {
            box-shadow: 0 0 40px rgba(244, 196, 48, 0.3), 0 0 80px rgba(255, 107, 0, 0.15);
            transform: translateY(-2px);
        }
        @keyframes metal-border-shift {
            0% { border-image: linear-gradient(135deg, #F4C430, #FFD700, #FF6B00, #FFD700, #F4C430) 1; }
            50% { border-image: linear-gradient(135deg, #FFD700, #FF6B00, #F4C430, #FFD700, #FF6B00) 1; }
            100% { border-image: linear-gradient(135deg, #F4C430, #FFD700, #FF6B00, #FFD700, #F4C430) 1; }
        }

        .modal-card {
            background: rgba(15, 45, 26, 0.95);
            border: 2px solid transparent;
            border-image: linear-gradient(135deg, #F4C430, #FFD700, #FF6B00, #FFD700, #F4C430) 1;
            border-image-slice: 1;
            animation: metal-border-shift 4s ease-in-out infinite;
            border-radius: var(--radius);
            padding: 28px;
            max-width: 480px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            box-shadow: var(--gold-neon);
        }

        .btn-outline-gold {
            background: transparent;
            color: var(--gold-base);
            border: 1px solid var(--gold-base);
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.55rem;
            box-shadow: var(--gold-neon);
        }
        .btn-outline-gold:hover { background: rgba(244, 196, 48, 0.1); box-shadow: 0 0 30px rgba(244, 196, 48, 0.2); }

        .btn-danger {
            background: rgba(255, 51, 102, 0.15);
            color: var(--danger);
            border: 1px solid rgba(255, 51, 102, 0.3);
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.5rem;
        }
        .btn-danger:hover { background: rgba(255, 51, 102, 0.25); }

        .btn-primary {
            background: linear-gradient(135deg, var(--verde-bosque), var(--verde-bosque-light));
            border-color: var(--gold-base);
            color: var(--gold-base);
            -webkit-text-fill-color: var(--gold-base);
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            padding: 8px 20px;
            border-radius: 30px;
            border: 1px solid var(--gold-base);
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.65rem;
            box-shadow: var(--gold-neon);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, var(--verde-bosque-light), var(--verde-bosque));
            box-shadow: 0 0 40px rgba(244, 196, 48, 0.3);
        }

        .modal-18 {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
        }
        .modal-18.hidden { display: none; }

        .tab-btn {
            padding: 8px 18px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-family: 'Orbitron', monospace;
            font-size: 0.55rem;
            font-weight: 600;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.3s;
        }
        .tab-btn.active { color: var(--gold-base); border-bottom-color: var(--gold-base); }
        .tab-btn:hover { color: var(--text-secondary); }

        .flair-chip {
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.5rem;
            font-family: 'Orbitron', monospace;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-muted);
            transition: all 0.3s;
        }
        .flair-chip.active {
            background: rgba(244, 196, 48, 0.15);
            border-color: var(--gold-base);
            color: var(--gold-base);
            box-shadow: 0 0 20px rgba(244, 196, 48, 0.1);
        }
        .flair-chip:hover { border-color: var(--gold-base); }

        .flair-badge {
            font-size: 0.45rem;
            padding: 2px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-family: 'Orbitron', monospace;
        }
        .flair-meme { background: rgba(244, 196, 48, 0.2); color: var(--gold-base); }
        .flair-confesion { background: rgba(255, 51, 102, 0.15); color: var(--danger); }
        .flair-chisme { background: rgba(0, 212, 255, 0.15); color: #00d4ff; }
        .flair-rant { background: rgba(255, 165, 0, 0.15); color: #ffa500; }
        .flair-crush { background: rgba(255, 107, 157, 0.15); color: #ff6b9d; }

        .vote-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
            padding: 2px;
            line-height: 1;
        }
        .vote-btn:hover { color: var(--gold-base); }
        .vote-btn.upvoted { color: var(--gold-base); text-shadow: 0 0 20px rgba(244, 196, 48, 0.3); }
        .vote-btn.downvoted { color: var(--danger); }

        .video-container {
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            background: #0a0a0a;
            border: 1px solid var(--border);
        }
        .video-container video {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            display: block;
        }

        .toast {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%) translateY(80px);
            background: var(--verde-bosque);
            color: var(--gold-base);
            padding: 12px 24px;
            border-radius: var(--radius);
            font-weight: 600;
            font-size: 0.8rem;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 5000;
            pointer-events: none;
            font-family: 'Orbitron', monospace;
            border: 1px solid var(--border);
            max-width: 90%;
            text-align: center;
            box-shadow: var(--gold-neon);
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast.error { background: var(--danger); color: white; }

        .empty-state { text-align: center; padding: 40px 20px; color: var(--text-muted); }
        .empty-state .icon { font-size: 2.5rem; opacity: 0.3; margin-bottom: 8px; }
        .empty-state h3 { font-family: 'Orbitron', monospace; font-size: 0.85rem; color: var(--text-secondary); }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeInUp 0.3s ease-out forwards; }

        .toggle-switch {
            width: 40px;
            height: 22px;
            background: #1a3a2a;
            border-radius: 12px;
            position: relative;
            cursor: pointer;
            transition: all 0.3s;
        }
        .toggle-switch.active { background: var(--gold-base); }
        .toggle-switch .knob {
            width: 18px;
            height: 18px;
            background: white;
            border-radius: 50%;
            position: absolute;
            top: 2px;
            left: 2px;
            transition: all 0.3s;
        }
        .toggle-switch.active .knob { left: 20px; }

        .border-gold { border-color: var(--border); }

        @media (max-width: 768px) {
            .modal-card { padding: 20px; margin: 10px; }
            .post-card { flex-wrap: wrap; }
            .post-card .vote-bar { flex-direction: row; width: 100%; justify-content: center; padding-top: 0; }
            .tab-btn { font-size: 0.45rem; padding: 6px 12px; }
            .btn-gold { padding: 6px 14px; font-size: 0.55rem; }
        }

        @media (max-width: 480px) {
            .modal-card { padding: 16px; }
            .modal-card h2 { font-size: 0.9rem; }
            .modal-card p { font-size: 0.7rem; }
            .flair-chip { font-size: 0.4rem; padding: 2px 10px; }
            .post-card { padding: 10px; }
        }
    </style>
</head>
