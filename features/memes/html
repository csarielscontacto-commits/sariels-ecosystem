    <script>
        // ================================================================
        // CONFIGURACIÓN (MANTENIDA)
        // ================================================================
        let currentUserId = localStorage.getItem('csariels_user_id') || 'user_test';
        let currentUserName = localStorage.getItem('csariels_user_name') || 'Usuario';
        let currentUserAvatar = localStorage.getItem('csariels_user_avatar') || 'U';

        let posts = [];
        let currentTab = 'hot';
        let selectedFlair = 'MEME';
        let toastTimeout = null;

        // ================================================================
        // 🔒 INICIALIZAR SEGURIDAD
        // ================================================================
        function initSeguridad() {
            if (window.Security) {
                window.Security.initSeguridad();
                console.log('🛡️ Seguridad activada para Memes y Confesiones');
            } else {
                console.warn('⚠️ Security.js no cargado - verifica la ruta');
            }
        }

        // ================================================================
        // 🔴 VERIFICAR DATOS ANTES DE VER CONTENIDO
        // ================================================================
        async function puedeVerContenido(consumo_mb = 2, modulo = 'muro_meme') {
            try {
                const puede = await window.esimConnector?.puedeEjecutarAccion(consumo_mb, modulo);
                if (!puede || !puede.puede) {
                    mostrarToast(puede?.mensaje || '⚠️ Sin conexión a internet', 'error');
                    if (puede?.recargar) {
                        setTimeout(() => {
                            if (confirm('📶 ¿Quieres ir a Mi Red para activar o recargar tu eSIM?')) {
                                window.location.href = '../usuario/index.html#esim';
                            }
                        }, 1000);
                    }
                    return false;
                }
                return true;
            } catch (error) {
                console.error('❌ Error verificando datos:', error);
                mostrarToast('⚠️ Error al verificar conexión', 'error');
                return false;
            }
        }

        // ================================================================
        // 🚀 SUPABASE - CARGAR POSTS
        // ================================================================
        async function cargarPosts() {
            const puede = await puedeVerContenido(2, 'muro_meme');
            if (!puede) {
                document.getElementById('feedContainer').innerHTML = `
                    <div class="empty-state">
                        <div class="icon">📶</div>
                        <h3>Sin conexión a internet</h3>
                        <p>Activa tu eSIM o conecta WiFi para ver memes y confesiones.</p>
                        <button class="btn-gold text-xs mt-3 py-2 px-4" onclick="window.location.href='../usuario/index.html#esim'">
                            <i class="fas fa-sim-card"></i> Ir a Mi Red
                        </button>
                    </div>
                `;
                return;
            }

            try {
                const resultado = await muroConnector.obtenerPosts('memes', 20);
                if (resultado.error) {
                    console.error('❌ Error al cargar posts 18+:', resultado.error);
                    mostrarToast('❌ Error al cargar publicaciones', 'error');
                    return;
                }
                posts = resultado.data || [];
                console.log(`✅ ${posts.length} posts 18+ cargados de Supabase`);
                renderizarFeed();
            } catch (error) {
                console.error('❌ Error en cargarPosts:', error);
                mostrarToast('❌ Error de conexión', 'error');
            }
        }

        // ================================================================
        // RENDER FEED
        // ================================================================
        function renderizarFeed() {
            const container = document.getElementById('feedContainer');

            if (!posts || posts.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon">📭</div>
                        <h3>Sin publicaciones</h3>
                        <p>Sé el primero en compartir algo en el Muro +18.</p>
                    </div>
                `;
                return;
            }

            let sorted = [...posts];
            if (currentTab === 'new') {
                sorted.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            } else if (currentTab === 'top') {
                sorted.sort((a, b) => (b.likes_count || 0) - (a.likes_count || 0));
            } else {
                sorted.sort((a, b) => (b.likes_count || 0) - (a.likes_count || 0));
            }

            container.innerHTML = sorted.map(post => {
                const flairClass = {
                    'MEME': 'flair-meme',
                    'CONFESIÓN': 'flair-confesion',
                    'CHISME': 'flair-chisme',
                    'RANT': 'flair-rant',
                    'CRUSH': 'flair-crush'
                } [post.flair] || 'flair-meme';

                const autor = post.usuario?.nombre || 'Anónimo';
                const avatar = post.usuario?.foto_perfil || autor.charAt(0);
                const verificado = post.usuario?.verificado || false;
                const isConfesion = post.flair === 'CONFESIÓN' && !post.is_revealed;
                const likes = post.likes_count || 0;
                const userLiked = post.usuario_liked || false;
                const comments = post.comments_count || 0;

                let mediaHTML = '';
                let isVideo = false;
                let videoSrc = '';
                
                if (post.media_url) {
                    const isImage = post.media_type === 'image' || post.media_url.match(/\.(jpg|jpeg|png|gif|webp)/i);
                    isVideo = post.media_type === 'video' || post.media_url.match(/\.(mp4|webm|mov)/i);
                    videoSrc = post.media_url;
                    
                    if (isImage) {
                        mediaHTML = `
                            <div class="rounded-xl overflow-hidden mt-2">
                                <img src="${post.media_url}" alt="Meme" class="w-full max-h-[300px] object-cover" loading="lazy" />
                            </div>
                        `;
                    } else if (isVideo) {
                        mediaHTML = `
                            <div class="video-container mt-2">
                                <video id="meme-video-${post.id}" autoplay muted loop playsinline preload="metadata" class="w-full max-h-[400px] object-cover">
                                    <source src="${post.media_url}" type="video/mp4" />
                                </video>
                            </div>
                        `;
                    }
                }

                const isUpvoted = post.user_vote === 1;
                const isDownvoted = post.user_vote === -1;

                return `
                    <div class="post-card animate-in">
                        <div class="vote-bar flex flex-col items-center gap-0.5 pt-1 w-9 flex-shrink-0">
                            <button class="vote-btn ${isUpvoted ? 'upvoted' : ''}" onclick="votarPost('${post.id}', 1)">
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <span class="font-['Orbitron'] text-sm font-bold text-[#e8f0f8]">${likes}</span>
                            <button class="vote-btn ${isDownvoted ? 'downvoted' : ''}" onclick="votarPost('${post.id}', -1)">
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                                <span class="flair-badge ${flairClass}">${post.flair || 'MEME'}</span>
                                <span class="text-[#4a6a8a] text-[0.6rem] font-['Orbitron']">${autor}</span>
                                ${verificado ? '<span style="color:var(--success);font-size:0.5rem;">✅</span>' : ''}
                                <span class="text-[#4a6a8a] text-[0.5rem]">${formatDate(post.created_at)}</span>
                            </div>

                            <div class="text-[#e8f0f8] text-sm leading-relaxed ${isConfesion ? 'blur-md cursor-pointer' : ''}" 
                                 ${isConfesion ? `onclick="revelarPost('${post.id}')"` : ''}>
                                ${post.contenido || ''}
                            </div>
                            ${isConfesion ? `<span class="text-[#F4C430] text-xs font-['Orbitron'] cursor-pointer" onclick="revelarPost('${post.id}')" style="text-shadow: 0 0 20px rgba(244,196,48,0.2);">👆 Toca para revelar</span>` : ''}

                            ${mediaHTML}

                            <div class="flex flex-wrap items-center gap-4 pt-3 mt-2 border-t border-[rgba(244,196,48,0.05)]">
                                <button class="text-[#4a6a8a] hover:text-[#F4C430] transition text-xs flex items-center gap-1" onclick="toggleLike('${post.id}')">
                                    <i class="fas fa-heart ${userLiked ? 'text-[#F4C430]' : ''}"></i> ${likes}
                                </button>
                                <button class="text-[#4a6a8a] hover:text-[#F4C430] transition text-xs flex items-center gap-1" onclick="mostrarToast('💬 Comentarios pronto')">
                                    <i class="fas fa-comment"></i> ${comments}
                                </button>
                                <button class="text-[#4a6a8a] hover:text-[#F4C430] transition text-xs flex items-center gap-1" onclick="mostrarToast('📋 Enlace copiado')">
                                    <i class="fas fa-share"></i> Compartir
                                </button>
                                <button class="text-[#4a6a8a] hover:text-[#ff3366] transition text-xs flex items-center gap-1" onclick="mostrarToast('🚩 Reportado', 'error')">
                                    <i class="fas fa-flag"></i> Reportar
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            // Verificar datos para videos
            document.querySelectorAll('.video-container video').forEach(video => {
                const postId = video.id.replace('meme-video-', '');
                let consumo = 3;

                video.addEventListener('play', async function(e) {
                    if (this.dataset.verified === 'true') return;
                    const puede = await puedeVerContenido(consumo, 'muro_meme');
                    if (!puede) {
                        this.pause();
                        e.preventDefault();
                        return;
                    }
                    this.dataset.verified = 'true';
                });

                video.play().catch(async (err) => {
                    const puede = await puedeVerContenido(consumo, 'muro_meme');
                    if (puede) {
                        video.play().catch(() => {});
                    }
                });
            });
        }

        // ================================================================
        // PUBLICAR POST
        // ================================================================
        async function publicarPost() {
            const puede = await puedeVerContenido(0.5, 'muro_meme');
            if (!puede) return;

            const input = document.getElementById('postInput');
            const texto = input.value.trim();

            if (!texto) {
                mostrarToast('⚠️ Escribe algo para publicar', 'error');
                return;
            }

            const nuevoPost = {
                usuario_id: currentUserId,
                contenido: texto,
                tipo: 'publicacion',
                is_18: true,
                is_live: false,
                flair: selectedFlair
            };

            try {
                const resultado = await muroConnector.crearPost(nuevoPost);
                if (resultado.error) {
                    console.error('❌ Error al publicar 18+:', resultado.error);
                    mostrarToast('❌ Error al publicar', 'error');
                    return;
                }

                mostrarToast('✅ Publicación creada en Muro +18');
                document.getElementById('postInput').value = '';
                await cargarPosts();
            } catch (error) {
                console.error('❌ Error en publicarPost:', error);
                mostrarToast('❌ Error de conexión', 'error');
            }
        }

        // ================================================================
        // LIKE
        // ================================================================
        async function toggleLike(postId) {
            try {
                const resultado = await muroConnector.darLike(postId, currentUserId);
                if (resultado.error) {
                    console.error('❌ Error al dar like:', resultado.error);
                    mostrarToast('❌ Error al dar like', 'error');
                    return;
                }
                await cargarPosts();
            } catch (error) {
                console.error('❌ Error en toggleLike:', error);
                mostrarToast('❌ Error de conexión', 'error');
            }
        }

        // ================================================================
        // VOTAR
        // ================================================================
        async function votarPost(postId, direction) {
            if (direction === 1) {
                await toggleLike(postId);
            } else {
                mostrarToast('⬇️ Downvote registrado (demo)');
            }
        }

        // ================================================================
        // FUNCIONES AUXILIARES
        // ================================================================
        function selectFlair(flair) {
            selectedFlair = flair;
            document.querySelectorAll('.flair-chip').forEach(el => {
                el.classList.toggle('active', el.dataset.flair === flair);
            });
            document.getElementById('selectedFlairDisplay').textContent = flair;
        }

        function revelarPost(postId) {
            mostrarToast('👀 Confesión revelada');
        }

        function simularVideo() {
            const input = document.getElementById('postInput');
            if (!input.value.trim()) {
                input.value = '📹 Video compartido';
            }
            mostrarToast('🎬 Video agregado a la publicación');
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.toggle('active', el.dataset.tab === tab);
            });
            renderizarFeed();
        }

        function formatDate(timestamp) {
            if (!timestamp) return 'Ahora';
            const date = new Date(timestamp);
            const now = new Date();
            const diff = Math.floor((now - date) / 1000);
            if (diff < 60) return 'Ahora';
            if (diff < 3600) return `hace ${Math.floor(diff / 60)}m`;
            if (diff < 86400) return `hace ${Math.floor(diff / 3600)}h`;
            return `hace ${Math.floor(diff / 86400)}d`;
        }

        function mostrarToast(mensaje, tipo = '') {
            const toast = document.getElementById('toast');
            toast.textContent = mensaje;
            toast.className = `toast${tipo ? ' error' : ''}`;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function resetAge() {
            localStorage.removeItem('csariels_18');
            localStorage.removeItem('csariels_18_confirmed');
            location.reload();
        }

        // ================================================================
        // CARGAR SCRIPTS DEL ASISTENTE
        // ================================================================
        function cargarScriptsAsistente() {
            const scripts = [
                '/assets/js/asistente-config.js',
                '/assets/js/asistente-ia.js'
            ];
            
            let loaded = 0;
            scripts.forEach(src => {
                const script = document.createElement('script');
                script.src = src;
                script.onload = () => {
                    loaded++;
                    if (loaded === scripts.length && typeof window.CsarielsAsistente !== 'undefined') {
                        window.CsarielsAsistente.iniciar('muro-meme');
                        console.log('✅ Asistente IA inicializado en Memes y Confesiones');
                    }
                };
                script.onerror = () => {
                    console.warn('⚠️ No se pudo cargar:', src);
                };
                document.body.appendChild(script);
            });
        }

        // ================================================================
        // INICIALIZAR
        // ================================================================
        document.addEventListener('DOMContentLoaded', function() {
            initSeguridad();

            console.log('🎭 Csariel\'s - Memes y Confesiones ✨');
            console.log('🤖 Asistente IA cargado en Memes y Confesiones');
            console.log('📶 Verificación de datos eSIM activada');

            cargarScriptsAsistente();

            fetch('/assets/components/asistente-widget.html')
                .then(res => {
                    if (!res.ok) throw new Error('No se pudo cargar el widget');
                    return res.text();
                })
                .then(html => {
                    document.getElementById('asistenteContainer').innerHTML = html;
                    console.log('✅ Widget Asistente IA cargado en Memes y Confesiones');
                })
                .catch(err => {
                    console.warn('⚠️ Error cargando widget asistente:', err);
                });

            const edadConfirmada = localStorage.getItem('csariels_18_confirmed') || localStorage.getItem('csariels_18');
            if (edadConfirmada === '1' || edadConfirmada === 'true') {
                document.getElementById('modal18').classList.add('hidden');
                document.getElementById('app').style.display = 'block';
                
                const perfil = JSON.parse(localStorage.getItem('miPerfil_csariels') || '{}');
                if (perfil.userId) currentUserId = perfil.userId;
                if (perfil.nombre) currentUserName = perfil.nombre;
                if (perfil.fotoPerfil) currentUserAvatar = perfil.fotoPerfil;

                cargarPosts();
            }

            const ageCheck = document.getElementById('ageCheck');
            const btnEnter = document.getElementById('btnEnter');

            ageCheck.addEventListener('change', function() {
                btnEnter.disabled = !this.checked;
            });

            btnEnter.addEventListener('click', function() {
                if (!ageCheck.checked) return;
                localStorage.setItem('csariels_18_confirmed', 'true');
                localStorage.setItem('csariels_18', '1');
                document.getElementById('modal18').classList.add('hidden');
                document.getElementById('app').style.display = 'block';
                cargarPosts();
                mostrarToast('🔞 Acceso concedido al Muro +18');
            });
        });

        window.selectFlair = selectFlair;
        window.publicarPost = publicarPost;
        window.votarPost = votarPost;
        window.revelarPost = revelarPost;
        window.simularVideo = simularVideo;
        window.switchTab = switchTab;
        window.toggleLike = toggleLike;
        window.mostrarToast = mostrarToast;
        window.resetAge = resetAge;
    </script>

</body>
</html>