                    s.nombre.toLowerCase().includes(searchTerm) ||
                    s.descripcion.toLowerCase().includes(searchTerm) ||
                    s.categoria.toLowerCase().includes(searchTerm)
                );
            }

            if (userLocation) {
                filtrados = filtrados.map(s => {
                    const dist = calcularDistancia(userLocation.lat, userLocation.lng, s.lat, s.lng);
                    return { ...s, distancia: dist };
                }).sort((a, b) => (a.distancia || 999) - (b.distancia || 999));
