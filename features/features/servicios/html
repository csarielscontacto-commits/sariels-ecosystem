<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Servicios Comunitarios | Csariel's</title>
    <meta name="theme-color" content="#0F2D1A" />

    <meta http-equiv="Content-Security-Policy" content="
        default-src 'self';
        script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://*.supabase.co https://*.polygon.technology https://cdn.tailwindcss.com;
        style-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.tailwindcss.com https://unpkg.com 'unsafe-inline';
        font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com;
        img-src 'self' data: https://*;
        connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.polygon.technology https://*.tile.openstreetmap.org;
        frame-src 'self';
        media-src 'self';
        object-src 'none';
        base-uri 'self';
        form-action 'self';
    ">

    <script src="../../js/security.js"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Grotesk:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
    <script src="../../js/servicios-connector.js"></script>
    <script src="../../js/perfil-connector.js"></script>
    <script src="../../js/esim-connector.js"></script>
    <script src="../../js/config.js"></script>
    
    <style>
        /* ===== TODOS TUS ESTILOS EXISTENTES (MANTENIDOS) ===== */
        :root {
            --space-deep: #05080f;
            --space-mid: #0a1428;
            --verde-bosque: #0F2D1A;
            --verde-bosque-light: #1a4a2a;
            --gold-cosmic: #D4AF37;
            --gold-dim: rgba(212,175,55,0.15);
            --gold-glow: rgba(212,175,55,0.25);
            --text-primary: #e8f0f8;
            --text-secondary: #8ba3c7;
            --text-muted: #4a6a8a;
            --border: rgba(212,175,55,0.08);
            --border-glow: rgba(212,175,55,0.25);
            --radius: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --success: #00b894;
            --danger: #ff3366;
            --warning: #D4AF37;
            --quantum: #00e5ff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            background: var(--space-deep);
            color: var(--text-primary);
            font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        #stars-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .nebula {
            position: fixed;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.10;
            pointer-events: none;
            z-index: 0;
            animation: nebula-drift 25s ease-in-out infinite alternate;
        }
        .nebula-1 { width: 700px; height: 700px; background: var(--verde-bosque); top: -15%; right: -15%; }
        .nebula-2 { width: 600px; height: 600px; background: var(--gold-cosmic); bottom: -15%; left: -15%; animation-delay: -8s; opacity: 0.05; }
        .nebula-3 { width: 500px; height: 500px; background: var(--quantum); top: 50%; left: 50%; transform: translate(-50%, -50%); animation-delay: -15s; opacity: 0.04; }

        @keyframes nebula-drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, -30px) scale(1.15); }
        }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--space-deep); }
        ::-webkit-scrollbar-thumb { background: linear-gradient(var(--gold-cosmic), var(--verde-bosque)); border-radius: 3px; }

        .app {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 20px 30px;
        }

        /* ===== HEADER ===== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0 16px;
            border-bottom: 2px solid var(--gold-dim);
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
            backdrop-filter: blur(10px);
            position: relative;
        }
        .header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-cosmic), var(--verde-bosque), var(--gold-cosmic), transparent);
            opacity: 0.4;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }
        .logo-icon { font-size: 2rem; filter: drop-shadow(0 0 20px rgba(212,175,55,0.2)); animation: pulse-glow 3s ease-in-out infinite; }
        .logo-icon .hex {
            display: inline-block;
            background: var(--verde-bosque);
            color: var(--gold-cosmic);
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 900;
            border: 2px solid var(--gold-cosmic);
            font-family: 'Orbitron', monospace;
        }
        @keyframes pulse-glow { 0%, 100% { filter: drop-shadow(0 0 20px rgba(212,175,55,0.2)); } 50% { filter: drop-shadow(0 0 40px rgba(212,175,55,0.4)); } }

        .logo-text {
            font-family: 'Orbitron', monospace;
            font-size: 1.3rem;
            font-weight: 900;
            letter-spacing: 2px;
            background: linear-gradient(135deg, var(--gold-cosmic), var(--verde-bosque-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .logo-badge {
            font-family: 'Orbitron', monospace;
            font-size: 0.45rem;
            background: linear-gradient(135deg, var(--verde-bosque), var(--gold-cosmic));
            color: white;
            padding: 3px 12px;
            border-radius: 20px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            -webkit-text-fill-color: white;
            border: 1px solid rgba(212,175,55,0.2);
            animation: badge-pulse 2s ease-in-out infinite;
        }
        @keyframes badge-pulse { 0%, 100% { box-shadow: 0 0 30px rgba(15,45,26,0.3); } 50% { box-shadow: 0 0 60px rgba(212,175,55,0.2); } }

        .header-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .status-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(212,175,55,0.06);
            border: 1px solid rgba(212,175,55,0.15);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.6rem;
            color: var(--gold-cosmic);
            font-family: 'Orbitron', monospace;
            backdrop-filter: blur(10px);
        }
        .status-dot { width: 7px; height: 7px; border-radius: 50%; animation: quantum-pulse 1.5s ease-in-out infinite; }
        .status-dot.online { background: var(--success); box-shadow: 0 0 20px rgba(0,184,148,0.5); }
        @keyframes quantum-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.7); } }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 16px;
            border: 1px solid var(--border);
            border-radius: 30px;
            background: rgba(212,175,55,0.03);
            color: var(--text-primary);
            font-family: 'Orbitron', monospace;
            font-size: 0.6rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }
        .btn:hover { transform: scale(1.02); border-color: var(--border-glow); }
        .btn-primary {
            background: linear-gradient(135deg, var(--verde-bosque), var(--verde-bosque-light));
            border-color: var(--gold-cosmic);
            color: var(--gold-cosmic);
            -webkit-text-fill-color: var(--gold-cosmic);
        }
        .btn-primary:hover:not(:disabled) {
            background: linear-gradient(135deg, var(--verde-bosque-light), var(--verde-bosque));
            box-shadow: 0 0 40px rgba(15,45,26,0.5);
        }
        .btn-gold {
            background: linear-gradient(135deg, var(--gold-cosmic), #b8923a);
            border-color: transparent;
            color: #0a0c10;
            -webkit-text-fill-color: #0a0c10;
        }
        .btn-gold:hover:not(:disabled) { box-shadow: 0 0 40px rgba(212,175,55,0.3); }
        .btn-outline { border-color: var(--border); background: transparent; }
        .btn-outline:hover:not(:disabled) { background: rgba(212,175,55,0.05); border-color: var(--gold-cosmic); }
        .btn-sm { padding: 4px 12px; font-size: 0.55rem; }
        .btn-danger {
            background: rgba(255,51,102,0.15);
            border-color: rgba(255,51,102,0.3);
            color: var(--danger);
        }
        .btn-danger:hover:not(:disabled) { background: rgba(255,51,102,0.25); }
        .btn-success {
            background: linear-gradient(135deg, #00b894, #00897b);
            border-color: transparent;
            color: white;
            -webkit-text-fill-color: white;
        }
        .btn-success:hover:not(:disabled) {
            background: linear-gradient(135deg, #00897b, #00695c);
            box-shadow: 0 0 40px rgba(0,184,148,0.3);
        }

        /* ===== AVISO SERVICIOS COMUNITARIOS ===== */
        .servicios-aviso {
            background: #1f1915;
            border: 1px solid #2a221c;
            border-left: 3px solid #c9a876;
            border-radius: 8px;
            padding: 14px 18px;
            margin: 12px 0 16px;
            font-family: 'Inter', sans-serif;
            display: none;
            position: relative;
        }
        .servicios-aviso .cerrar-aviso {
            position: absolute;
            top: 6px;
            right: 10px;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1.1rem;
            cursor: pointer;
            transition: var(--transition);
            padding: 0 4px;
        }
        .servicios-aviso .cerrar-aviso:hover {
            color: var(--text-primary);
            transform: rotate(90deg);
        }
        .servicios-aviso p {
            color: #d4c8b8;
            font-size: 0.8rem;
            margin: 0 0 4px;
        }
        .servicios-aviso p:last-child { margin-bottom: 0; }
        .servicios-aviso .aviso-titulo {
            color: #c9a876;
            font-weight: 600;
            font-size: 0.9rem;
            margin: 0 0 6px;
        }
        .servicios-aviso a {
            color: #c9a876;
            font-size: 0.75rem;
            text-decoration: underline;
        }
        .servicios-aviso .bullet { display: inline-block; margin-right: 4px; }

        /* ===== SMART SEARCH ===== */
        .smart-search-container {
            background: rgba(15,45,26,0.2);
            border: 1px solid var(--gold-dim);
            border-radius: var(--radius);
            padding: 16px 20px;
            margin-bottom: 16px;
            backdrop-filter: blur(10px);
        }
        .smart-search-container .title {
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            color: var(--gold-cosmic);
            margin-bottom: 4px;
        }
        .smart-search-container .subtitle {
            font-size: 0.75rem;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }
        .smart-search-container .search-input-wrapper {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .smart-search-container .search-input-wrapper input {
            flex: 1;
            padding: 12px 16px;
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--gold-dim);
            border-radius: 12px;
            color: var(--text-primary);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.95rem;
            outline: none;
            transition: var(--transition);
            min-width: 200px;
        }
        .smart-search-container .search-input-wrapper input:focus {
            border-color: var(--gold-cosmic);
            box-shadow: 0 0 30px rgba(212,175,55,0.1);
        }
        .smart-search-results {
            margin-top: 16px;
            padding: 16px;
            background: rgba(0,0,0,0.2);
            border-radius: 12px;
            border: 1px solid var(--gold-dim);
            display: none;
        }
        .smart-search-results.visible { display: block; animation: fadeInUp 0.3s ease-out; }
        .smart-search-results .result-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--gold-dim);
        }
        .smart-search-results .result-header .icono { font-size: 2rem; }
        .smart-search-results .result-header .info { flex: 1; }
        .smart-search-results .result-header .info .categoria {
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            color: var(--gold-cosmic);
        }
        .smart-search-results .result-header .info .confianza {
            font-size: 0.7rem;
            color: var(--text-muted);
        }
        .smart-search-results .result-list { display: flex; flex-direction: column; gap: 8px; }
        .smart-search-results .result-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            background: rgba(0,0,0,0.15);
            border-radius: 10px;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: var(--transition);
        }
        .smart-search-results .result-item:hover {
            border-color: var(--border-glow);
            transform: translateX(4px);
        }
        .smart-search-results .result-item .nombre { font-weight: 600; color: var(--text-primary); }
        .smart-search-results .result-item .detalle {
            font-size: 0.7rem;
            color: var(--text-muted);
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .smart-search-results .result-item .detalle .calificacion { color: var(--gold-cosmic); }
        .smart-search-results .result-item .detalle .distancia { color: var(--quantum); }
        .smart-search-results .result-item .detalle .urgente {
            color: var(--danger);
            font-weight: 700;
            animation: pulse-warning 1s infinite;
        }
        @keyframes pulse-warning {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .smart-search-results .no-resultados {
            text-align: center;
            padding: 20px;
            color: var(--text-muted);
        }
        .smart-search-results .sugerencias {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--gold-dim);
        }
        .smart-search-results .sugerencias .sugerencia {
            font-size: 0.65rem;
            background: rgba(212,175,55,0.05);
            border: 1px solid var(--gold-dim);
            padding: 4px 12px;
            border-radius: 20px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: var(--transition);
        }
        .smart-search-results .sugerencias .sugerencia:hover {
            background: rgba(212,175,55,0.1);
            color: var(--gold-cosmic);
        }

        /* ===== SEARCH BAR ===== */
        .search-bar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 16px;
            align-items: center;
        }
        .search-bar .search-input-wrapper {
            flex: 1;
            min-width: 200px;
            position: relative;
        }
        .search-bar .search-input-wrapper input {
            width: 100%;
            padding: 10px 14px 10px 40px;
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--gold-dim);
            border-radius: 12px;
            color: var(--text-primary);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.9rem;
            outline: none;
            transition: var(--transition);
        }
        .search-bar .search-input-wrapper input:focus { border-color: var(--gold-cosmic); }
        .search-bar .search-input-wrapper .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }
        .search-bar .btn-geolocation {
            background: rgba(0,212,255,0.1);
            border: 1px solid rgba(0,212,255,0.15);
            color: var(--quantum);
            padding: 10px 18px;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Orbitron', monospace;
            font-size: 0.6rem;
            white-space: nowrap;
        }
        .search-bar .btn-geolocation:hover {
            background: rgba(0,212,255,0.2);
            border-color: var(--quantum);
        }

        /* ===== CATEGORÍAS ===== */
        .categories-scroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 4px 0 12px;
            margin-bottom: 16px;
            scrollbar-width: thin;
            flex-wrap: nowrap;
        }
        .categories-scroll::-webkit-scrollbar { height: 3px; }
        .categories-scroll::-webkit-scrollbar-thumb { background: var(--gold-cosmic); border-radius: 3px; }
        .cat-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 8px 16px;
            background: rgba(15,45,26,0.2);
            border: 1px solid var(--gold-dim);
            border-radius: 12px;
            color: var(--text-secondary);
            font-family: 'Orbitron', monospace;
            font-size: 0.5rem;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
            min-width: 60px;
        }
        .cat-btn:hover { border-color: var(--border-glow); color: var(--text-primary); }
        .cat-btn.active { border-color: var(--gold-cosmic); background: var(--gold-dim); color: var(--gold-cosmic); }
        .cat-btn .cat-icon { font-size: 1.4rem; }

        /* ===== MAPA ===== */
        #map-container {
            width: 100%;
            height: 300px;
            border-radius: var(--radius);
            border: 1px solid var(--gold-dim);
            overflow: hidden;
            margin-bottom: 16px;
            background: var(--space-deep);
        }
        #map-container .leaflet-control-zoom a {
            background: rgba(15,45,26,0.8);
            color: var(--text-primary);
            border-color: var(--gold-dim);
        }
        #map-container .leaflet-control-zoom a:hover {
            background: rgba(15,45,26,0.9);
            color: var(--gold-cosmic);
        }

        /* ===== SERVICES GRID ===== */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 12px;
            margin-top: 8px;
        }
        .service-card {
            background: rgba(15,45,26,0.25);
            border: 1px solid var(--gold-dim);
            border-radius: var(--radius);
            padding: 16px 18px;
            transition: var(--transition);
            backdrop-filter: blur(10px);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        .service-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, var(--gold-cosmic), var(--verde-bosque), var(--gold-cosmic));
            background-size: 300% 300%;
            border-radius: var(--radius);
            z-index: -1;
            opacity: 0;
            animation: border-flow 4s ease-in-out infinite;
        }
        @keyframes border-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .service-card:hover::before { opacity: 0.15; }
        .service-card:hover {
            transform: translateY(-3px);
            border-color: var(--border-glow);
        }

        .service-card .service-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 6px;
        }
        .service-card .service-name {
            font-family: 'Orbitron', monospace;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .service-card .service-category {
            font-size: 0.5rem;
            background: rgba(212,175,55,0.1);
            border: 1px solid rgba(212,175,55,0.15);
            padding: 2px 10px;
            border-radius: 20px;
            color: var(--gold-cosmic);
            font-family: 'Orbitron', monospace;
        }
        .service-card .service-rating {
            display: flex;
            align-items: center;
            gap: 4px;
            margin: 4px 0;
        }
        .service-card .service-rating .stars { color: var(--gold-cosmic); font-size: 0.8rem; }
        .service-card .service-rating .score { font-size: 0.75rem; color: var(--text-secondary); }
        .service-card .service-distance {
            font-size: 0.65rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .service-card .service-distance i { color: var(--quantum); }
        .service-card .service-contact {
            display: flex;
            gap: 6px;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid var(--gold-dim);
            flex-wrap: wrap;
        }
        .service-card .service-contact .contact-item {
            font-size: 0.65rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .service-card .service-contact .contact-item i { color: var(--gold-cosmic); }
        .service-card .badge-verified {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(0,184,148,0.15);
            color: var(--success);
            border: 1px solid rgba(0,184,148,0.2);
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.45rem;
            font-family: 'Orbitron', monospace;
        }
        .badge-golden {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: linear-gradient(135deg, var(--gold-cosmic), #b8923a);
            color: #0a0c10;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 0.45rem;
            font-family: 'Orbitron', monospace;
            font-weight: 700;
            box-shadow: 0 0 20px rgba(212,175,55,0.3);
        }
        .badge-quarantine {
            display: inline-flex;
