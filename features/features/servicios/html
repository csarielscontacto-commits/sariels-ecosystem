                '<span style="cursor:pointer;" onclick="setRating(4)">☆</span>' +
                '<span style="cursor:pointer;" onclick="setRating(5)">☆</span>';
            document.getElementById('ratingText').textContent = 'Selecciona una calificación';
            document.getElementById('ratingComment').value = '';
            document.getElementById('btnSubmitRating').disabled = true;
            selectedRating = 0;
            cerrarModalServicio();
            document.getElementById('ratingModal').classList.add('active');
        }

        function setRating(rating) {
            selectedRating = rating;
            const stars = document.getElementById('ratingStars');
            const text = document.getElementById('ratingText');

            if (rating === 1) {
                cerrarModalRating();
                setTimeout(() => {
                    document.getElementById('ratingExtremeModal').classList.add('active');
                }, 300);
                return;
            }

            stars.innerHTML = '';
            for (let i = 1; i <= 5; i++) {
                const star = document.createElement('span');
                star.textContent = i <= rating ? '★' : '☆';
                star.style.cssText = `cursor:pointer;color:${i <= rating ? 'var(--gold-cosmic)' : 'var(--text-muted)'};font-size:2.5rem;`;
                star.onclick = () => setRating(i);
                stars.appendChild(star);
            }
            const textos = ['', 'Muy malo 😡', 'Malo 😕', 'Regular 😐', 'Bueno 😊', 'Excelente 🎉'];
            text.textContent = textos[rating] || '';
            document.getElementById('btnSubmitRating').disabled = false;
        }

        function cerrarModalRating() {
            document.getElementById('ratingModal').classList.remove('active');
        }

        function cerrarModalRatingExtreme() {
            document.getElementById('ratingExtremeModal').classList.remove('active');
            setTimeout(() => {
                document.getElementById('ratingModal').classList.add('active');
            }, 300);
        }

        function confirmarCalificacionExtrema() {
            const reason = document.getElementById('extremeReason').value.trim();
            if (reason.length < 20) {
                mostrarToast('⚠️ Debes explicar el motivo (mín 20 caracteres)', 'error');
                return;
            }
            cerrarModalRatingExtreme();
            document.getElementById('ratingComment').value = `⭐ 1 estrella - ${reason}`;
            enviarCalificacion();
        }

        // ================================================================
        // FILTROS
        // ================================================================
        function filtrarPorCategoria(categoria) {
            categoriaActual = categoria;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.cat === categoria);
            });
            renderizarServicios();
        }

        function filtrarServicios() {
            renderizarServicios();
        }

        // ================================================================
        // TOAST
        // ================================================================
        function mostrarToast(mensaje, tipo = '') {
            const toast = document.getElementById('toast');
            toast.textContent = mensaje;
            toast.className = `toast${tipo ? ' ' + tipo : ''}`;
            toast.classList.add('active');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('active'), 3000);
        }

        // ================================================================
        // CIERRE DE MODALES
        // ================================================================
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                cerrarFormularioServicio();
                cerrarModalServicio();
                limpiarBusquedaInteligente();
                cerrarModalRating();
                cerrarModalRatingExtreme();
            }
        });

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    if (this.id === 'offerServiceModal') cerrarFormularioServicio();
                    if (this.id === 'serviceModal') cerrarModalServicio();
                    if (this.id === 'ratingModal') cerrarModalRating();
                    if (this.id === 'ratingExtremeModal') cerrarModalRatingExtreme();
                }
            });
        });

        // ================================================================
        // INICIALIZAR
        // ================================================================
        document.addEventListener('DOMContentLoaded', async () => {
            initSeguridad();

            console.log('◈ Csariel\'s - Servicios Comunitarios (Conectado a Supabase + eSIM)');
            console.log('📶 Verificación de datos eSIM activada');
            
            if (!localStorage.getItem('servicios_aviso_visto')) {
                document.getElementById('serviciosAviso').style.display = 'block';
            }

            initStars();
            initMap();
            await cargarServicios();

            document.getElementById('extremeReason').addEventListener('input', function() {
                const count = this.value.length;
                document.getElementById('extremeCharCount').textContent = `${count} / 20`;
                document.getElementById('extremeCharCount').style.color = count >= 20 ? 'var(--success)' : 'var(--danger)';
            });

            console.log('✅ Servicios Comunitarios conectado a Supabase y eSIM');
        });

        window.buscarInteligente = buscarInteligente;
        window.buscarSugerencia = buscarSugerencia;
        window.limpiarBusquedaInteligente = limpiarBusquedaInteligente;
        window.filtrarPorCategoria = filtrarPorCategoria;
        window.filtrarServicios = filtrarServicios;
        window.abrirDetalleServicio = abrirDetalleServicio;
        window.cerrarModalServicio = cerrarModalServicio;
        window.contactarServicio = contactarServicio;
        window.calificarServicio = calificarServicio;
        window.setRating = setRating;
        window.confirmarCalificacionExtrema = confirmarCalificacionExtrema;
        window.enviarCalificacion = enviarCalificacion;
        window.abrirFormularioServicio = abrirFormularioServicio;
        window.cerrarFormularioServicio = cerrarFormularioServicio;
        window.registrarServicio = registrarServicio;
        window.obtenerUbicacion = obtenerUbicacion;
        window.mostrarToast = mostrarToast;
        window.cerrarServiciosAviso = cerrarServiciosAviso;
    </script>
</body>
</html>