                        })
                    }).addTo(map).bindPopup('📍 Tu ubicación');
                    map.setView([lat, lng], 14);
                    mostrarToast('📍 Ubicación obtenida');
                },
                function() {
                    userLocation = { lat: 19.0413, lng: -98.2062 };
                },
                { enableHighAccuracy: true }
            );
        }

