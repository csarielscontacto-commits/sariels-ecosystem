        function getIcono(categoria) {
            const iconos = {
                mecanico: '🔧', llantera: '🛞', grua: '🚗', gasolina: '⛽',
                plomero: '🚰', electricista: '⚡', albañil: '🧱', tecnico: '🖥️',
                celular: '📱', limpieza: '🧹', mudanza: '🚚', transporte: '🚕',
                comida: '🍽️', medico: '🩺', farmacia: '💊', profesor: '📚',
                veterinario: '🐕', cerrajero: '🏠', jardineria: '🌳', aire: '❄️',
                diseno: '🎨', otros: '📌'
            };
            return iconos[categoria] || '📌';
        }

        function getCategoriaNombre(categoria) {
            const nombres = {
                mecanico: 'Mecánico', llantera: 'Llantera', grua: 'Grúa',
                gasolina: 'Gasolina', plomero: 'Plomero', electricista: 'Electricista',
                albañil: 'Albañil', tecnico: 'Técnico', celular: 'Celulares',
                limpieza: 'Limpieza', mudanza: 'Mudanza', transporte: 'Transporte',
                comida: 'Comida', medico: 'Médico', farmacia: 'Farmacia',
                profesor: 'Profesor', veterinario: 'Veterinario', cerrajero: 'Cerrajero',
                jardineria: 'Jardinería', aire: 'Aire Acondicionado', diseno: 'Diseño',
                otros: 'Otros'
            };
            return nombres[categoria] || categoria;
        }

        function calcularDistancia(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            return 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)) * R;
        }

