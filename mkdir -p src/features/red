#!/bin/bash

# ================================================================
# 🚀 MOVER FEATURES/RED A SRC/FEATURES/RED
# ================================================================
# Hecho en Puebla, México 🇲🇽
# ================================================================

echo "🚀 Moviendo features/red a src/features/red..."

# 1. Crear la carpeta destino
mkdir -p src/features/red

# 2. Mover todo el contenido de features/red a src/features/red
mv features/red/* src/features/red/

# 3. Mover también archivos ocultos si existen
mv features/red/.[!.]* src/features/red/ 2>/dev/null || true

# 4. Eliminar la carpeta vacía
rmdir features/red 2>/dev/null || true

echo "✅ ¡Completado! features/red movido a src/features/red"

# 5. Mostrar estructura
echo ""
echo "📂 Estructura de src/features/red:"
ls -la src/features/red/

echo ""
echo "📍 Hecho en Puebla, México 🇲🇽"