# ================================================================
# CSARIEL'S ECOSYSTEM - .gitignore
# ================================================================

# ===== DEPENDENCIAS =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===== ENTORNO Y CONFIGURACIÓN =====
.env
.env.local
.env.*.local
*.env
*.key
*.pem
*.crt

# ===== IDE / EDITORES =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== CONSTRUCCIÓN =====
dist/
build/
out/
*.log
*.tmp
*.temp

# ===== ARCHIVOS DE SISTEMA =====
.directory
*.pid
*.seed
*.pid.lock
*.log

# ===== COBERTURA =====
coverage/
.nyc_output/

# ===== SUPABASE =====
.supabase/
supabase/.branches
supabase/.temp

# ===== VERCEl =====
.vercel/
vercel.json

# ===== BACKUPS =====
*.bak
*.backup
*.old
*.orig

# ===== ARCHIVOS DE USUARIO LOCAL =====
*.local
*.user
*.useros

# ===== CACHÉ =====
.cache/
.eslintcache
*.tsbuildinfo

# ===== MISCELÁNEOS =====
*.min.js
*.min.css
.map
*.map