// ================================================================
// SCHEMA PRISMA - CSARIEL'S BILLETERA + REGALOS LIVE
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// USUARIO
// ================================================================
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password_hash       String
  nombre              String
  negocio             String?
  clabe               String?   // CLABE para retiros SPEI
  saldo_disponible    Decimal   @default(0) @db.Decimal(12,2)
  saldo_pendiente     Decimal   @default(0) @db.Decimal(12,2) // Dinero en proceso de retiro
  createdAt           DateTime  @default(now())

  // Relaciones
  transacciones       Transaccion[]
  recargas            Recarga[]
  regalosEnviados     RegaloEnviado[]   @relation("regalosEnviados")
  regalosRecibidos    RegaloEnviado[]   @relation("regalosRecibidos")
  lives               Live[]

  @@map("users")
}

// ================================================================
// TRANSACCIÓN (Auditoría completa)
// ================================================================
model Transaccion {
  id                String    @id @default(cuid())
  userId            String
  tipo              String    // RECARGA, TRANSFERENCIA_INTERNA, REGALO_ENVIADO, REGALO_RECIBIDO, RETIRO, COMISION_PLATAFORMA
  monto             Decimal   @db.Decimal(12,2)
  comision          Decimal   @default(0) @db.Decimal(12,2)
  saldo_anterior    Decimal   @db.Decimal(12,2)
  saldo_nuevo       Decimal   @db.Decimal(12,2)
  idempotency_key   String?   @unique
  ip_address        String?
  user_agent        String?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transacciones")
}

// ================================================================
// RECARGA (SPEI / Transferencia)
// ================================================================
model Recarga {
  id                String    @id @default(cuid())
  userId            String
  monto             Decimal   @db.Decimal(12,2)
  estado            String    @default("PENDIENTE") // PENDIENTE, ACREDITADA, RECHAZADA
  referencia_spei   String?   // Número de referencia SPEI
  comprobante_url   String?
  acreditado_por    String?
  acreditado_en     DateTime?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recargas")
}

// ================================================================
// REGALO ENVIADO EN LIVE
// ================================================================
model RegaloEnviado {
  id                    String    @id @default(cuid())
  deUserId              String
  paraUserId            String
  regaloId              String    // llave_10, llanta_50, motor_100, taller_1000
  precio_total          Decimal   @db.Decimal(12,2)
  comision_plataforma   Decimal   @db.Decimal(12,2) // 30%
  ganancia_streamer     Decimal   @db.Decimal(12,2) // 70%
  liveId                String?
  idempotency_key       String    @unique
  createdAt             DateTime  @default(now())

  deUser                User      @relation("regalosEnviados", fields: [deUserId], references: [id])
  paraUser              User      @relation("regalosRecibidos", fields: [paraUserId], references: [id])
  live                  Live?     @relation(fields: [liveId], references: [id])

  @@map("regalos_enviados")
}

// ================================================================
// LIVE (Transmisión en vivo)
// ================================================================
model Live {
  id                String    @id @default(cuid())
  streamerUserId    String
  titulo            String
  plataforma        String?   // TIKTOK, FACEBOOK, YOUTUBE
  url_live          String?
  estado            String    @default("EN_VIVO") // EN_VIVO, FINALIZADO, CANCELADO
  createdAt         DateTime  @default(now())
  finalizado_en     DateTime?

  streamer          User      @relation(fields: [streamerUserId], references: [id])
  regalos           RegaloEnviado[]

  @@map("lives")
}

// ================================================================
// RESERVA GLOBAL (100% RESERVA - UNA SOLA FILA)
// ================================================================
model ReservaGlobal {
  id                      String    @id @default("reserva_unica")
  saldo_reserva_usuarios  Decimal   @default(0) @db.Decimal(12,2) // = SUM(saldo_disponible)
  saldo_ganancias         Decimal   @default(0) @db.Decimal(12,2) // Mi 30% de comisiones
  ultima_verificacion     DateTime? // Última vez que se verificó la reserva
  actualizado_en          DateTime  @updatedAt

  @@map("reserva_global")
}